// ==========================================
// OXFORD EDUCATION: Tablas específicas (Fase 3)
// ==========================================

enum OxfordLeadType {
  b2b_institutional
  b2c_individual
}

enum OxfordLeadStatus {
  nuevo
  primer_contacto
  en_calificacion
  interesado
  derivado_asesor
  en_atencion       // NUEVO (feature/ori-advisor-sla): asesor confirmó con ATIENDO, aún sin cerrar (LISTO)
  atendido_asesor
  sin_confirmar     // NUEVO (feature/ori-advisor-sla): se agotaron las 8 asesoras sin confirmación — requiere atención manual
  demo_agendada
  demo_completada
  propuesta_enviada
  en_negociacion
  cerrado_ganado
  cerrado_perdido
  no_interesado
  archivado
}

enum OxfordProduct {
  oxford_tcc
  oxford_tcc_kids
  english_teaching_certificate
  alphable
  oxford_life
  rising_stars
  work_study_spain
}

model OxfordLead {
  id                String             @id @default(uuid())
  contactId         String             @map("contact_id")
  leadType          OxfordLeadType     @default(b2c_individual) @map("lead_type")
  source            String?
  sourceDetail      String?            @map("source_detail")

  // Datos del contacto
  fullName          String?            @map("full_name")
  role              String?

  // Datos institucionales (B2B)
  institutionName   String?            @map("institution_name")
  institutionType   String?            @map("institution_type")
  estimatedStudents Int?               @map("estimated_students")
  currentCert       String?            @map("current_cert")
  schoolCycle       String?            @map("school_cycle")

  // Ubicación (ruteo geográfico de asesor)
  state             String?            @map("state")          // Estado de la república
  municipality      String?            @map("municipality")   // Alcaldía/municipio (si CDMX o Edo. México)
  zoneKey           String?            @map("zone_key")       // Dupla asignada: A/B/C/D

  // Productos de interés
  productsInterest  OxfordProduct[]    @map("products_interest")
  primaryProduct    OxfordProduct?     @map("primary_product")

  // Calificación
  temperature       String             @default("nuevo")
  score             Int                @default(0)
  status            OxfordLeadStatus   @default(nuevo)
  ticketNumber      Int                @default(autoincrement()) @unique @map("ticket_number")

  // Seguimiento
  assignedAgent     String?            @map("assigned_agent")
  assignedAdvisor   String?            @map("assigned_advisor") // Asesor humano de la dupla (handoff)
  nurturingSequence String?            @map("nurturing_sequence")
  nurturingStep     Int                @default(0) @map("nurturing_step")
  nextFollowUp      DateTime?          @map("next_follow_up")
  followUpCount     Int                @default(0) @map("follow_up_count")

  // SLA de confirmación del asesor (feature/ori-advisor-sla) — ver advisor-sla.js.
  // Todo aditivo/nullable; Travel y Work & Study nunca lo tocan.
  assignedAt        DateTime?          @map("assigned_at")           // cuándo se asignó el INTENTO actual (se sobreescribe en cada reasignación)
  confirmedAt       DateTime?          @map("confirmed_at")          // cuándo el asesor confirmó con ATIENDO (una sola vez)
  responseSeconds   Int?               @map("response_seconds")      // confirmedAt - assignedAt del intento que confirmó
  slaDueAt          DateTime?          @map("sla_due_at")            // assignedAt + OXED_ADVISOR_SLA_MINUTES; el job de reasignación hace poll aquí
  currentAttempt    Int                @default(0) @map("current_attempt")   // se incrementa en cada (re)asignación; evita que un job viejo actúe sobre una asignación nueva
  reassignCount     Int                @default(0) @map("reassign_count")    // cuenta SOLO reasignaciones (no la asignación inicial)
  triedAdvisorKeys  String[]           @default([]) @map("tried_advisor_keys") // keys de advisor-zones.ADVISORS ya intentados en esta cadena
  advisorAttempts   Json?              @default("[]") @map("advisor_attempts") // rastro: [{advisor, assignedAt, result}], result: esperando|confirmo|no_confirmo

  // Reunión/Demo
  meetingDate       DateTime?          @map("meeting_date")
  meetingAttended   Boolean?           @map("meeting_attended")
  meetingNotes      String?            @map("meeting_notes")

  // Propuesta (B2B)
  proposalSent      Boolean            @default(false) @map("proposal_sent")
  proposalDate      DateTime?          @map("proposal_date")
  proposalAmount    Float?             @map("proposal_amount")

  // Metadata
  materialsSent     String[]           @default([]) @map("materials_sent")
  tags              String[]           @default([])
  notes             String?
  extras            Json?              @default("{}")
  zohoId            String?            @map("zoho_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  contact           Contact            @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([leadType])
  @@index([temperature])
  @@index([status])
  @@index([primaryProduct])
  @@map("oxford_leads")
}
